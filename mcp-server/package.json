{
  "name": "sprintly-mcp",
  "version": "0.1.0",
  "description": "MCP server that wraps the sprintly.cloud CLI — exposes every sprintly subcommand as a typed MCP tool.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "sprintly-mcp": "dist/server.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/server.ts",
    "dev:http": "tsx src/server-http.ts",
    "start": "node dist/server.js",
    "start:http": "node dist/server-http.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^5.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
